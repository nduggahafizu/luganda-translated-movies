    <!-- Suppress third-party console warnings -->
    <script>
        // Suppress known third-party warnings (YouTube API, AdSense) in production
        (function() {
            const originalWarn = console.warn;
            const originalError = console.error;
            
            console.warn = function(...args) {
                const msg = args.join(' ');
                // Filter out third-party warnings we can't control
                if (msg.includes('www-widgetapi.js') || 
                    msg.includes('target origin provided') ||
                    msg.includes('non-passive event listener') ||
                    msg.includes('Violation')) {
                    return;
                }
                originalWarn.apply(console, args);
            };
            
            console.error = function(...args) {
                const msg = args.join(' ');
                // Filter YouTube API origin errors
                if (msg.includes('www-widgetapi.js') || 
                    msg.includes('target origin provided')) {
                    return;
                }
                originalError.apply(console, args);
            };
        })();
    </script>
    
