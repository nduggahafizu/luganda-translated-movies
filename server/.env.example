# ================================
# Luganda Movies API Configuration
# ================================

# Server Configuration
NODE_ENV=development
PORT=5000

# ================================
# Database Configuration
# ================================
# MongoDB Atlas Connection String
# Get this from: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/luganda-movies?retryWrites=true&w=majority

# ================================
# JWT Authentication
# ================================
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-use-long-random-string
# Must be a DIFFERENT random string from JWT_SECRET — required, no fallback.
# If unset, refresh token issuance/verification will fail (by design, not a bug).
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-different-from-jwt-secret-above
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ================================
# Session Configuration
# ================================
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-session-secret-key-change-this-in-production

# ================================
# CORS Configuration
# ================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,https://lugandamovies.com,https://www.lugandamovies.com

# Client URL (frontend)
CLIENT_URL=http://localhost:3000

# ================================
# Rate Limiting
# ================================
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# ================================
# Redis Cache Configuration
# ================================
# Local Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Redis Cloud (optional)
# REDIS_HOST=redis-12345.c123.us-east-1-1.ec2.cloud.redislabs.com
# REDIS_PORT=12345
# REDIS_PASSWORD=your-redis-password

# ================================
# Logging Configuration
# ================================
# Levels: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# ================================
# TMDB API (The Movie Database)
# ================================
# Get API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your-tmdb-api-key-here
TMDB_BASE_URL=https://api.themoviedb.org/3

# ================================
# Google OAuth Configuration
# ================================
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=573762962600-nr77v5emb2spn7aleg9p2l7c0d6be3a9.apps.googleusercontent.com

# ================================
# Payment Gateway (Pesapal)
# ================================
PESAPAL_CONSUMER_KEY=your-pesapal-consumer-key
PESAPAL_CONSUMER_SECRET=your-pesapal-consumer-secret
PESAPAL_CALLBACK_URL=http://localhost:5000/api/payments/callback
PESAPAL_IPN_URL=http://localhost:5000/api/payments/ipn

# ================================
# Email Configuration (Optional)
# ================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@lugandamovies.com

# ================================
# Cloud Storage (Optional)
# ================================
# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# ================================
# Cloudflare R2 (Recommended for Video Hosting)
# ================================
# FREE egress bandwidth! Great for video streaming
# Setup: https://dash.cloudflare.com → R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=unruly-videos
R2_PUBLIC_URL=https://videos.unrulymovies.com
AWS_S3_BUCKET=luganda-movies-uploads

# ================================
# Monitoring & Analytics (Optional)
# ================================
# Sentry for error tracking
SENTRY_DSN=your-sentry-dsn

# Google Analytics
GA_TRACKING_ID=UA-XXXXXXXXX-X

# ================================
# Production Settings
# ================================
# Set to 'true' in production
TRUST_PROXY=false

# Maximum request body size
MAX_REQUEST_SIZE=10mb

# ================================
# Web Push Notifications (VAPID)
# ================================
# Generate keys: cd server && node generate-vapid-keys.js
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:support@unrulymovies.com

# ================================
# MTN Mobile Money Uganda
# ================================
# Register at: https://momodeveloper.mtn.com
# Sandbox: https://sandbox.momodeveloper.mtn.com
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_SUBSCRIPTION_KEY=your-mtn-subscription-key
MTN_MOMO_API_USER=your-api-user-uuid
MTN_MOMO_API_KEY=your-api-key
MTN_MOMO_CALLBACK_URL=https://your-backend-url.com/api/payments/mtn/callback

# ================================
# Airtel Money Uganda
# ================================
# Register at: https://developers.airtel.africa
# After creating app, complete KYC verification for production access
AIRTEL_CLIENT_ID=your-airtel-client-id
AIRTEL_CLIENT_SECRET=your-airtel-client-secret
AIRTEL_MERCHANT_CODE=your-merchant-code
AIRTEL_ENVIRONMENT=sandbox
AIRTEL_CALLBACK_URL=https://your-backend-url.com/api/payments/airtel/callback

# ================================
# Feature Flags
# ================================
ENABLE_CACHING=true
ENABLE_RATE_LIMITING=true
ENABLE_LOGGING=true
ENABLE_MONITORING=true
ENABLE_PUSH_NOTIFICATIONS=true

# ================================
# Notes:
# ================================
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env file to version control
# 3. Use strong, random secrets for JWT and SESSION
# 4. Update ALLOWED_ORIGINS for production domains
# 5. Set NODE_ENV=production in production
# 6. Enable HTTPS in production (handled by reverse proxy)
# 7. Generate VAPID keys for push notifications
