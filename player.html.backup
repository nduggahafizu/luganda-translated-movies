            </div>
            
            <!-- Comments List -->
            <div class="comments-list" id="commentsList">
                <div class="comments-loading" id="commentsLoading">
                    <div class="spinner"></div>
                    <p>Loading comments...</p>
                </div>
                <div class="no-comments" id="noComments" style="display: none;">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                    <p>No comments yet. Be the first to share your thoughts!</p>
                </div>
                <!-- Comments will be loaded here -->
            </div>
            
            <!-- Load More Comments -->
            <button class="load-more-comments" id="loadMoreComments" style="display: none;">
                Load More Comments
            </button>
        </section>

        <!-- Related Content -->
        <section class="related-section" id="relatedSection">
            <h2 class="section-title">You May Also Like</h2>
            
            <!-- Ad Banner in Related Section -->
            <div class="ad-container" style="margin: 15px 0; text-align: center;">
                <ins class="adsbygoogle"
                     style="display:block"
                     data-ad-client="ca-pub-1904736753681797"
                     data-ad-slot="auto"
                     data-ad-format="fluid"
                     data-ad-layout-key="-fb+5w+4e-db+86"></ins>
                <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
            </div>
            
            <div class="related-grid" id="relatedGrid">
                <!-- Related movies will be loaded here -->
            </div>
        </section>
    </div>

    <!-- Footer -->
    <footer class="player-footer">
        <p>Copyright © unruly movies watch 2026</p>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.plyr.io/3.7.8/plyr.polyfilled.js?v=2024"></script>
    <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
    <script src="js/config.js"></script>
    <script src="js/auth.js"></script>
    <script>
        // AUTHENTICATION CHECK - Users must be logged in to watch movies
        (function() {
            const token = localStorage.getItem('token') || sessionStorage.getItem('token');
            if (!token) {
                // Save current URL to return after login
                const currentUrl = window.location.href;
                localStorage.setItem('redirectAfterLogin', currentUrl);
                // Redirect to login
                window.location.replace('login.html?redirect=' + encodeURIComponent(currentUrl));
                throw new Error('Authentication required');
            }
        })();
    </script>
    <script src="js/tmdb-api.js"></script>
    <script src="js/trailer-player.js"></script>
    <script src="js/social-share.js"></script>
    <script src="js/watchlist-manager.js"></script>
    <script src="js/notifications.js"></script>
    
    <!-- Back Button Handler - Prevent app close on Android -->
    <script>
        (function() {
            // Push a state so back button doesn't close the app
            if (window.history.length <= 2) {
                window.history.pushState({ playerPage: true }, '', window.location.href);
            }
            
            // Handle back button - go to home instead of closing
            window.addEventListener('popstate', function(event) {
                // Always go to home page from player
                window.location.href = '/';
            });
            
            // Scroll to top
            window.scrollTo(0, 0);
        })();
    </script>
    
    <script>
        // Initialize Plyr
        const video = document.getElementById('player');
        const embedContainer = document.getElementById('embedContainer');
        const embedPlayer = document.getElementById('embedPlayer');
        const loadingOverlay = document.getElementById('loadingOverlay');
        let player = null;
        let isEmbedMode = false;
        let currentMovieRequiredPlan = 'free';

        // Get URL parameters
        const urlParams = new URLSearchParams(window.location.search);
        const movieId = urlParams.get('id');
        const streamUrl = urlParams.get('stream');
        const embedUrl = urlParams.get('embed');
        const isSeries = urlParams.has('series');
        const isStation = urlParams.has('station');
        // Station playback uses the movie player but should not show movie-specific UI (VJ, recommendations, comments, etc.)
        const isNonMoviePlayback = isStation;

        // Expose key playback mode flags for shared scripts (e.g., js/login-gate.js)
        window.isNonMoviePlayback = isNonMoviePlayback;
        window.isEmbedMode = isEmbedMode;
        window.currentMovieRequiredPlan = currentMovieRequiredPlan;

        function setEmbedMode(next) {
            isEmbedMode = !!next;
            window.isEmbedMode = isEmbedMode;
        }

        function setCurrentMovieRequiredPlan(plan, idForEvent) {
            currentMovieRequiredPlan = (plan ? String(plan) : 'free');
            window.currentMovieRequiredPlan = currentMovieRequiredPlan;

            // Notify shared UX layers (e.g., smart login/subscription gate)
            try {
                window.dispatchEvent(new CustomEvent('unruly:requiredPlan', {
                    detail: {
                        requiredPlan: currentMovieRequiredPlan,
                        movieId: String(idForEvent || movieId || '')
                    }
                }));
            } catch (e) {}
        }

        function initPlaybackPreferencesUi() {
            const resumeToggle = document.getElementById('prefResume');
            const autoNextToggle = document.getElementById('prefAutoNext');
            const prefsBox = document.getElementById('playbackPreferences');

            if (!resumeToggle || !autoNextToggle || !prefsBox) return;

            // Hide preferences in non-movie playback modes
            if (isNonMoviePlayback) {
                prefsBox.style.display = 'none';
                return;
            }

            // Resume: default ON unless explicitly disabled
            const resumeEnabled = localStorage.getItem('unruly_resume_enabled') !== 'false';
            resumeToggle.checked = resumeEnabled;

            // Auto-next: default OFF
            const autoNextEnabled = localStorage.getItem('unruly_autonext') === 'true';
            autoNextToggle.checked = autoNextEnabled;

            resumeToggle.addEventListener('change', () => {
                localStorage.setItem('unruly_resume_enabled', resumeToggle.checked ? 'true' : 'false');
            });

            autoNextToggle.addEventListener('change', () => {
                localStorage.setItem('unruly_autonext', autoNextToggle.checked ? 'true' : 'false');
            });
        }

        // If this is a legacy TV-series link, redirect to the dedicated series player.
        // Example legacy URL: player.html?series=<id>&season=1&episode=1
        if (isSeries) {
            const legacySeriesId = urlParams.get('series');
            const season = urlParams.get('season');
            const episode = urlParams.get('episode');

            if (legacySeriesId) {
                const redirectParams = new URLSearchParams();
                redirectParams.set('id', legacySeriesId);
                if (season) redirectParams.set('season', season);
                if (episode) redirectParams.set('episode', episode);
                window.location.replace(`series-player.html?${redirectParams.toString()}`);
            }
        }

        function applyNonMoviePlaybackUi() {
            const vjInfo = document.getElementById('vjInfo');
            if (vjInfo) vjInfo.style.display = 'none';

            const relatedSection = document.getElementById('relatedSection');
            if (relatedSection) relatedSection.style.display = 'none';

            const commentsSection = document.getElementById('commentsSection');
            if (commentsSection) commentsSection.style.display = 'none';

            const qualitySelector = document.getElementById('qualitySelector');
            if (qualitySelector) qualitySelector.style.display = 'none';

            const watchlistBtn = document.getElementById('watchlistBtn');
            if (watchlistBtn) watchlistBtn.style.display = 'none';

            const likeBtn = document.getElementById('likeBtn');
            if (likeBtn) likeBtn.style.display = 'none';

            const downloadBtn = document.getElementById('downloadBtn');
            if (downloadBtn) downloadBtn.style.display = 'none';

            const showMoreBtn = document.getElementById('showMoreBtn');
            if (showMoreBtn) showMoreBtn.style.display = 'none';

            const movieMeta = document.getElementById('movieMeta');
            if (movieMeta) movieMeta.style.display = 'none';

            const playbackPreferences = document.getElementById('playbackPreferences');
            if (playbackPreferences) playbackPreferences.style.display = 'none';
        }

        if (isNonMoviePlayback) {
            applyNonMoviePlaybackUi();
        }

        initPlaybackPreferencesUi();

        // Comments system variables (declared early to avoid temporal dead zone)
        let commentsPage = 1;
        const commentsPerPage = 10;
        let allComments = [];
        
        // ========== VIDEO PRELOADER FOR FASTER START ==========
        // Prefetch video URL to prime DNS and TCP connections
        function prefetchVideoUrl(url) {
            if (!url) return;
            
            // Create a link prefetch element
            const link = document.createElement('link');
            link.rel = 'prefetch';
            link.href = url;
            link.as = 'video';
            link.crossOrigin = 'anonymous';
            document.head.appendChild(link);
            
            // Also try to prime the connection with a small range request
            // This warms up the CDN edge server
            try {
                fetch(url, {
                    method: 'GET',
                    headers: { 'Range': 'bytes=0-1000' },  // Just get first 1KB
                    mode: 'no-cors'  // Avoid CORS issues
                }).catch(() => {}); // Ignore errors, this is just optimization
            } catch (e) {}
            
            console.log('🚀 Prefetching video URL:', url.substring(0, 60));
        }
        
        // ========== PRE-ROLL AD SYSTEM (AdSense Only) ==========
        const prerollAdConfig = {
            enabled: false,                   // Set to true when you have AdSense video ads
            skipAfterSeconds: 5,              // Allow skip after X seconds
            maxAdDuration: 30,                // Maximum ad duration in seconds
            fallbackToDisplay: false,         // Use AdSense display ad as fallback
            displayAdDuration: 5,             // Display ad duration in seconds
            // Note: AdSense video ads use Google Ad Manager, not direct URLs
            videoAdSources: []
        };

        let prerollAdPlayed = false;          // Track if ad was already played this session
        let pendingVideoUrl = null;           // Store the movie URL to play after ad
        let pendingVideoType = null;          // 'direct', 'embed', or 'archive'

        // Pre-roll Ad Elements
        const prerollContainer = document.getElementById('prerollAdContainer');
        const prerollVideo = document.getElementById('prerollAdVideo');
        const prerollDisplayAd = document.getElementById('prerollDisplayAd');
        const prerollOverlay = document.getElementById('prerollAdOverlay');
        const prerollSkipBtn = document.getElementById('prerollSkipBtn');
        const skipCountdown = document.getElementById('skipCountdown');
        const prerollProgress = document.getElementById('prerollProgress');
        const displayAdCountdown = document.getElementById('displayAdCountdown');

        // Initialize Pre-roll Ad System
        function initPrerollAd(movieUrl, videoType) {
            if (!prerollAdConfig.enabled || prerollAdPlayed) {
                // Skip ad and play video directly
                playMainVideo(movieUrl, videoType);
                return;
            }

            // Store pending video info
            pendingVideoUrl = movieUrl;
            pendingVideoType = videoType;

            // Check if we have video ads
            if (prerollAdConfig.videoAdSources.length > 0) {
                playVideoAd();
            } else if (prerollAdConfig.fallbackToDisplay) {
                showDisplayAd();
            } else {
                // No ads configured, play video directly
                playMainVideo(movieUrl, videoType);
            }
        }

        // Play Video Ad
        function playVideoAd() {
            const randomAd = prerollAdConfig.videoAdSources[
                Math.floor(Math.random() * prerollAdConfig.videoAdSources.length)
            ];

            prerollContainer.classList.add('active');
            prerollVideo.style.display = 'block';
            prerollDisplayAd.style.display = 'none';
            prerollOverlay.style.display = 'flex';

            prerollVideo.src = randomAd;
            prerollVideo.load();
            
            // Try to play with sound first, fall back to muted
            prerollVideo.muted = false;
            prerollVideo.play().catch(() => {
                prerollVideo.muted = true;
                prerollVideo.play();
            });

            let skipTimer = prerollAdConfig.skipAfterSeconds;
            
            // Update skip countdown
            const skipInterval = setInterval(() => {
                skipTimer--;
                skipCountdown.textContent = skipTimer;
                
                if (skipTimer <= 0) {
                    clearInterval(skipInterval);
                    prerollSkipBtn.disabled = false;
                    prerollSkipBtn.innerHTML = 'Skip Ad →';
                }
            }, 1000);

            // Update progress bar
            prerollVideo.addEventListener('timeupdate', () => {
                const progress = (prerollVideo.currentTime / prerollVideo.duration) * 100;
                prerollProgress.style.width = progress + '%';
            });

            // Ad ended naturally
            prerollVideo.addEventListener('ended', () => {
                clearInterval(skipInterval);
                closePrerollAd();
            });

            // Handle ad errors - fallback to display ad
            prerollVideo.addEventListener('error', () => {
                clearInterval(skipInterval);
                if (prerollAdConfig.fallbackToDisplay) {
                    showDisplayAd();
                } else {
                    closePrerollAd();
                }
            });

            // Skip button click
            prerollSkipBtn.onclick = () => {
                clearInterval(skipInterval);
                closePrerollAd();
            };
        }

        // Show Display Ad (fallback)
        function showDisplayAd() {
            prerollContainer.classList.add('active');
            prerollVideo.style.display = 'none';
            prerollDisplayAd.style.display = 'flex';
            prerollOverlay.style.display = 'none';

            // Try to push AdSense ad
            try {
                (adsbygoogle = window.adsbygoogle || []).push({});
            } catch (e) {
                console.log('AdSense not available');
            }

            let countdown = prerollAdConfig.displayAdDuration;
            displayAdCountdown.textContent = `Video starts in ${countdown} seconds...`;

            const countdownInterval = setInterval(() => {
                countdown--;
                displayAdCountdown.textContent = `Video starts in ${countdown} seconds...`;
                
                if (countdown <= 0) {
                    clearInterval(countdownInterval);
                    closePrerollAd();
                }
            }, 1000);
        }

        // Close Pre-roll Ad and Play Main Video
        function closePrerollAd() {
            prerollAdPlayed = true;
            prerollContainer.classList.remove('active');
            
            // Stop ad video
            prerollVideo.pause();
            prerollVideo.src = '';

            // Play the main video
            if (pendingVideoUrl && pendingVideoType) {
                playMainVideo(pendingVideoUrl, pendingVideoType);
            }
        }

        // Play Main Video (after ad or directly)
        function playMainVideo(url, type) {
            console.log('🎬 Playing main video:', type, url);
            
            switch(type) {
                case 'direct':
                    loadVideoSource(url);
                    break;
                case 'embed':
                    loadEmbedVideo(url);
                    break;
                default:
                    loadVideoSource(url);
            }
        }

        // ========== END PRE-ROLL AD SYSTEM ==========

        function getStoredAuthToken() {
            return localStorage.getItem('token') || sessionStorage.getItem('token');
        }

        async function getPlaybackToken(apiUrl, movieId) {
            const token = getStoredAuthToken();
            if (!token) return null;

            const response = await fetch(`${apiUrl}/api/video/playback-token`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${token}`
                },
                body: JSON.stringify({ movieId })
            });

            const data = await response.json().catch(() => ({}));
            if (!response.ok) {
                const message = data?.message || 'Subscription required to play this content.';
                throw new Error(message);
            }

            return data?.token || null;
        }

        async function getSecureArchiveStreamUrl(apiUrl, movie) {
            const id = movie?._id || movie?.id || movieId;
            const requiredPlan = movie?.requiredPlan || 'free';
            setCurrentMovieRequiredPlan(requiredPlan, id);

            // Free content streams without token
            if (requiredPlan === 'free') {
                return `${apiUrl}/api/video/stream/luganda/${id}`;
            }

            // Paid content needs a short-lived playback token (video tags can't attach Authorization headers)
            let playbackToken = null;
            try {
                playbackToken = await getPlaybackToken(apiUrl, id);
            } catch (e) {
                try {
                    window.dispatchEvent(new CustomEvent('unruly:playbackDenied', {
                        detail: {
                            requiredPlan,
                            message: e?.message || 'Subscription required to play this content.'
                        }
                    }));
                } catch (err) {}
                throw e;
            }

            if (!playbackToken) {
                const err = new Error('Please login to play this content.');
                try {
                    window.dispatchEvent(new CustomEvent('unruly:playbackDenied', {
                        detail: {
                            requiredPlan,
                            message: err.message
                        }
                    }));
                } catch (e) {}
                throw err;
            }

            return `${apiUrl}/api/video/stream/luganda/${id}?token=${encodeURIComponent(playbackToken)}`;
        }

        // ========== CLOUD VIDEO LINK CONVERTERS ==========
        
        // Check if URL is a Cloudflare Stream URL
        function isCloudflareStreamUrl(url) {
            if (!url) return false;
            return url.includes('cloudflarestream.com') || url.includes('videodelivery.net');
        }
        
        // Convert Cloudflare Stream URL to direct playable format
        // Input: https://customer-xxx.cloudflarestream.com/VIDEO_ID/watch
        // Output: { hls: 'manifest URL', mp4: 'download URL' }
        function getCloudflareDirectUrls(url) {
            if (!url) return null;
            
            // Extract customer subdomain and video ID from various Cloudflare URL formats
            let customerId = null;
            let videoId = null;
            
            // Format: https://customer-xxx.cloudflarestream.com/VIDEO_ID/watch
            const watchMatch = url.match(/customer-([^.]+)\.cloudflarestream\.com\/([a-f0-9]+)/i);
            if (watchMatch) {
                customerId = watchMatch[1];
                videoId = watchMatch[2];
            }
            
            // Format: https://videodelivery.net/VIDEO_ID
            const deliveryMatch = url.match(/videodelivery\.net\/([a-f0-9]+)/i);
            if (deliveryMatch) {
                videoId = deliveryMatch[1];
            }
            
            // Format: https://watch.cloudflarestream.com/VIDEO_ID
            const watchCfMatch = url.match(/watch\.cloudflarestream\.com\/([a-f0-9]+)/i);
            if (watchCfMatch) {
                videoId = watchCfMatch[1];
            }
            
            // Format: https://iframe.cloudflarestream.com/VIDEO_ID or with params
            const iframeMatch = url.match(/iframe\.cloudflarestream\.com\/([a-f0-9]+)/i);
            if (iframeMatch) {
                videoId = iframeMatch[1];
            }
            
            if (!videoId) {
                console.log('⚠️ Could not extract video ID from Cloudflare URL:', url);
                return null;
            }
            
            // Build direct URLs
            const baseUrl = customerId 
                ? `https://customer-${customerId}.cloudflarestream.com/${videoId}`
                : `https://videodelivery.net/${videoId}`;
            
            return {
                hls: `${baseUrl}/manifest/video.m3u8`,
                dash: `${baseUrl}/manifest/video.mpd`,
                mp4: `${baseUrl}/downloads/default.mp4`,
                thumbnail: `${baseUrl}/thumbnails/thumbnail.jpg`,
                poster: `${baseUrl}/thumbnails/thumbnail.jpg?time=0s`,
                original: url
            };
        }
        
        // Check if URL is from other cloud providers and convert to direct link
        function convertCloudVideoUrl(url) {
            if (!url) return { type: 'direct', url: url };
            
            // Cloudflare Stream
            if (isCloudflareStreamUrl(url)) {
                const cfUrls = getCloudflareDirectUrls(url);
                if (cfUrls) {
                    console.log('☁️ Cloudflare Stream detected, using HLS:', cfUrls.hls);
                    return { 
                        type: 'hls', 
                        url: cfUrls.hls, 
                        fallbackUrl: cfUrls.mp4,
                        poster: cfUrls.poster,
                        allUrls: cfUrls 
                    };
                }
            }
            
            // Bunny.net CDN (bunnycdn.com or b-cdn.net)
            if (url.includes('bunnycdn.com') || url.includes('b-cdn.net')) {
                // Bunny CDN URLs are usually direct, but check for HLS
                if (url.includes('/play/')) {
                    // Convert play URL to HLS
                    const hlsUrl = url.replace('/play/', '/').replace(/\/?$/, '/playlist.m3u8');
                    console.log('🐰 Bunny CDN detected, trying HLS:', hlsUrl);
                    return { type: 'hls', url: hlsUrl, fallbackUrl: url };
                }
                return { type: 'direct', url: url };
            }
            
            // Vimeo (if direct URL provided)
            if (url.includes('vimeocdn.com') || url.includes('player.vimeo.com')) {
                console.log('📹 Vimeo CDN detected');
                return { type: 'direct', url: url };
            }
            
            // Default: treat as direct video URL
            return { type: 'direct', url: url };
        }
        
        // ========== END CLOUD VIDEO LINK CONVERTERS ==========

        // Check if URL is a direct video file (can be played natively)
        function isDirectVideoUrl(url) {
            if (!url) return false;
            
            // Clean URL for extension checking (remove query params and hash)
            const cleanUrl = url.split('?')[0].split('#')[0].toLowerCase();
            
            // Archive.org EMBED URLs should use iframe (better compatibility)
            if (url.includes('archive.org/embed/')) return false;
            
            // Archive.org direct downloads - now including MKV (remuxed via backend)
            // Also check for CDN subdomain URLs (ia800101.us.archive.org, etc.)
            if (url.includes('archive.org/download/') || url.match(/ia\d+\.us\.archive\.org/) || url.includes('/items/')) {
                // MP4, WebM, and MKV (MKV will be remuxed to MP4 via backend)
                if (cleanUrl.endsWith('.mp4') || cleanUrl.endsWith('.webm') || cleanUrl.endsWith('.mkv')) return true;
            }
            
            // Direct video file extensions (browser-compatible + MKV which gets remuxed)
            const videoExtensions = ['.mp4', '.webm', '.m4v', '.m3u8', '.mkv'];
            if (videoExtensions.some(ext => cleanUrl.endsWith(ext) || cleanUrl.includes(ext))) return true;
            
            // Google Drive direct links
            if (url.includes('drive.google.com') && url.includes('export=download')) return true;
            
            // Cloudflare R2 public URLs
            if (url.includes('.r2.dev/')) return true;
            
            // Backblaze B2 URLs
            if (url.includes('backblazeb2.com')) return true;
            
            return false;
        }
        
        // Show video unavailable message
        function showVideoUnavailable(movieTitle) {
            const loadingOverlay = document.getElementById('loadingOverlay');
            loadingOverlay.style.display = 'none';
            
            // Hide the video and embed elements
            const videoEl = document.getElementById('player');
            const embedEl = document.getElementById('embedContainer');
            if (videoEl) videoEl.style.display = 'none';
            if (embedEl) embedEl.style.display = 'none';
            
            // Show message in player area
            const playerContainer = document.getElementById('playerWrapper') || document.querySelector('.player-wrapper');
            if (playerContainer) {
                // Create unavailable message element
                const unavailableDiv = document.createElement('div');
                unavailableDiv.className = 'video-unavailable-message';
                unavailableDiv.style.cssText = 'display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 300px; aspect-ratio: 16/9; background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); border-radius: 12px; padding: 40px; text-align: center;';
                unavailableDiv.innerHTML = `
                        <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#ff6b6b" stroke-width="1.5" style="margin-bottom: 20px;">
                            <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"></rect>
                            <line x1="7" y1="2" x2="7" y2="22"></line>
                            <line x1="17" y1="2" x2="17" y2="22"></line>
                            <line x1="2" y1="12" x2="22" y2="12"></line>
                            <line x1="2" y1="7" x2="22" y2="7"></line>
                            <line x1="2" y1="17" x2="22" y2="17"></line>
                        </svg>
                        <h2 style="color: #fff; margin-bottom: 10px; font-size: 24px;">Video Unavailable</h2>
                        <p style="color: #aaa; margin-bottom: 20px; max-width: 400px;">
                            The video for "${movieTitle || 'this movie'}" is not available yet. 
                            Our team is working on adding it. Please check back later!
                        </p>
                        <a href="movies.html" style="display: inline-flex; align-items: center; gap: 8px; padding: 12px 24px; background: var(--primary-color, #7CFC00); color: #000; text-decoration: none; border-radius: 8px; font-weight: 600;">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                <polyline points="9 22 9 12 15 12 15 22"></polyline>
                            </svg>
                            Browse Available Movies
                        </a>
                `;
                playerContainer.appendChild(unavailableDiv);
            }
        }
        
        // Check if URL is a valid video URL (not placeholder/pending)
        function isValidVideoUrl(url) {
            if (!url) return false;
            const cleanUrl = url.trim().replace(/\s+/g, '');
            // Check for invalid/placeholder URLs
            if (cleanUrl === '' || 
                cleanUrl === 'pending-upload' || 
                cleanUrl === 'http://archive.org' ||
                cleanUrl === 'https://archive.org' ||
                cleanUrl.length < 20) {
                console.log('⚠️ Invalid video URL detected:', url);
                return false;
            }
            return true;
        }
        
        // Auto-rotate to landscape on fullscreen (like YouTube)
        function setupAutoRotate(playerInstance) {
            // Check if Screen Orientation API is supported
            const screenOrientation = screen.orientation || screen.mozOrientation || screen.msOrientation;
            
            // Detect if on mobile device
            const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
            
            if (!isMobile) {
                console.log('📱 Auto-rotate: Desktop detected, skipping');
                return;
            }
            
            console.log('📱 Auto-rotate: Mobile detected, setting up rotation');
            
            // Listen for Plyr fullscreen events
            if (playerInstance && playerInstance.on) {
                playerInstance.on('enterfullscreen', async () => {
                    console.log('🔄 Entering fullscreen - rotating to landscape');
                    try {
                        if (screenOrientation && screenOrientation.lock) {
                            await screenOrientation.lock('landscape');
                        } else if (screen.lockOrientation) {
                            screen.lockOrientation('landscape');
                        } else if (screen.mozLockOrientation) {
                            screen.mozLockOrientation('landscape');
                        } else if (screen.msLockOrientation) {
                            screen.msLockOrientation('landscape');
                        }
                    } catch (e) {
                        console.log('⚠️ Could not lock orientation:', e.message);
                    }
                });
                
                playerInstance.on('exitfullscreen', async () => {
                    console.log('🔄 Exiting fullscreen - unlocking orientation');
                    try {
                        if (screenOrientation && screenOrientation.unlock) {
                            screenOrientation.unlock();
                        } else if (screen.unlockOrientation) {
                            screen.unlockOrientation();
                        } else if (screen.mozUnlockOrientation) {
                            screen.mozUnlockOrientation();
                        } else if (screen.msUnlockOrientation) {
                            screen.msUnlockOrientation();
                        }
                    } catch (e) {
                        console.log('⚠️ Could not unlock orientation:', e.message);
                    }
                });
            }
            
            // Also listen for native fullscreen API (for iframe embeds)
            document.addEventListener('fullscreenchange', async () => {
                const isFullscreen = !!document.fullscreenElement;
                
                if (isFullscreen) {
                    console.log('🔄 Fullscreen detected - rotating to landscape');
                    try {
                        if (screenOrientation && screenOrientation.lock) {
                            await screenOrientation.lock('landscape');
                        }
                    } catch (e) {
                        console.log('⚠️ Could not lock orientation:', e.message);
                    }
                } else {
                    console.log('🔄 Exited fullscreen - unlocking orientation');
                    try {
                        if (screenOrientation && screenOrientation.unlock) {
                            screenOrientation.unlock();
                        }
                    } catch (e) {
                        console.log('⚠️ Could not unlock orientation:', e.message);
                    }
                }
            });
            
            // Webkit fullscreen (Safari/iOS)
            document.addEventListener('webkitfullscreenchange', async () => {
                const isFullscreen = !!document.webkitFullscreenElement;
                
                if (isFullscreen) {
                    try {
                        if (screenOrientation && screenOrientation.lock) {
                            await screenOrientation.lock('landscape');
                        }
                    } catch (e) {
                        console.log('⚠️ Could not lock orientation:', e.message);
                    }
                } else {
                    try {
                        if (screenOrientation && screenOrientation.unlock) {
                            screenOrientation.unlock();
                        }
                    } catch (e) {
                        console.log('⚠️ Could not unlock orientation:', e.message);
                    }
                }
            });
        }

        // Initialize Plyr only for native video - YOUTUBE STYLE
        function initPlyr() {
            if (player) return player;
            
            // Remove crossorigin to avoid CORS issues with Archive.org
            video.removeAttribute('crossorigin');
            
            // Set video attributes for faster loading
            video.preload = 'auto';
            video.playsInline = true;
            video.setAttribute('playsinline', '');
            
            // Ensure video is visible before Plyr initialization
            video.style.display = 'block';
            video.style.width = '100%';
            video.style.height = 'auto';
            
            player = new Plyr(video, {
                // YouTube-style controls (no rewind/fast-forward buttons)
                controls: [
                    'play-large',     // Big center play button
                    'play',           // Play/pause in control bar
                    'progress',       // Seek bar
                    'current-time',   // Current time
                    'duration',       // Total duration
                    'mute',           // Volume toggle
                    'volume',         // Volume slider
                    'captions',       // Subtitles
                    'settings',       // Settings menu
                    'pip',            // Picture-in-picture
                    'fullscreen'      // Fullscreen
                ],
                settings: ['captions', 'quality', 'speed'],
                speed: { selected: 1, options: [0.25, 0.5, 0.75, 1, 1.25, 1.5, 1.75, 2] },
                keyboard: { focused: true, global: true },
                tooltips: { controls: true, seek: true },
                seekTime: 5,           // Arrow keys seek 5 seconds (like YouTube)
                invertTime: false,
                toggleInvert: false,
                displayDuration: true,
                ratio: '16:9',
                fullscreen: { enabled: true, fallback: true, iosNative: true, container: null },
                loadSprite: true,      // Use Plyr's built-in sprite
                iconUrl: 'https://cdn.plyr.io/3.7.8/plyr.svg',  // Official Plyr icons
                blankVideo: '',
                autoplay: false,
                resetOnEnd: false,
                disableContextMenu: false,
                hideControls: true,    // Auto-hide controls (YouTube behavior)
                clickToPlay: true,     // Click/tap to play/pause
                storage: { enabled: true, key: 'plyr' }
            });
            
            // Setup auto-rotate for mobile
            setupAutoRotate(player);
            
            // Setup mobile touch controls handling
            setupMobileTouchControls(player);
            
            // Player ready - YouTube-style behavior
            player.on('ready', () => {
                console.log('🚀 Plyr ready - YouTube style enabled');
                // Controls will auto-hide during playback (handled by Plyr + CSS)
                // Apply saved video fit/fill preference
                applyVideoFitMode();
            });
            
            return player;
        }
        
        // Handle mobile touch to show/hide controls
        function setupMobileTouchControls(playerInstance) {
            if (!playerInstance || !playerInstance.elements || !playerInstance.elements.container) return;
            
            const container = playerInstance.elements.container;
            let hideTimeout = null;
            const HIDE_DELAY = 3000; // 3 seconds
            
            // Detect if touch device
            const isTouchDevice = 'ontouchstart' in window || navigator.maxTouchPoints > 0;
            
            // Show controls function
            function showControls() {
                container.classList.add('plyr--show-controls');
                container.classList.remove('plyr--hide-controls');
            }
            
            // Hide controls function
            function hideControls() {
                if (playerInstance.playing) {
                    container.classList.remove('plyr--show-controls');
                    container.classList.add('plyr--hide-controls');
                }
            }
            
            // Start/restart hide timer
            function startHideTimer() {
                if (hideTimeout) clearTimeout(hideTimeout);
                hideTimeout = setTimeout(hideControls, HIDE_DELAY);
            }
            
            // Show controls temporarily
            function showControlsTemporarily() {
                showControls();
                startHideTimer();
            }
            
            if (isTouchDevice) {
                // Touch devices: tap to toggle controls
                container.addEventListener('touchend', (e) => {
                    // Ignore taps on controls
                    if (e.target.closest('.plyr__controls') || e.target.closest('.plyr__control')) {
                        startHideTimer();
                        return;
                    }
                    
                    if (playerInstance.playing) {
                        if (container.classList.contains('plyr--show-controls')) {
                            hideControls();
                        } else {
                            showControlsTemporarily();
                        }
                    }
                }, { passive: true });
            } else {
                // Desktop: mouse movement shows controls
                container.addEventListener('mousemove', () => {
                    showControlsTemporarily();
                });
                
                container.addEventListener('mouseleave', () => {
                    if (playerInstance.playing) {
                        hideControls();
                    }
                });
            }
            
            // Always show when paused
            playerInstance.on('pause', () => {
                if (hideTimeout) clearTimeout(hideTimeout);
                showControls();
            });
            
            // Start hide timer when playing
            playerInstance.on('play', () => {
                showControlsTemporarily();
            });
            
            // Show controls when seeking
            playerInstance.on('seeking', () => {
                showControlsTemporarily();
            });
            
            // Cleanup
            playerInstance.on('destroy', () => {
                if (hideTimeout) clearTimeout(hideTimeout);
            });
            
            console.log('📱 Mobile touch controls initialized');
        }

        function requestElementFullscreen(el) {
            if (!el) return;
            const req = el.requestFullscreen || el.webkitRequestFullscreen || el.msRequestFullscreen;
            if (req) req.call(el);
        }

        // Fullscreen helper for iframe embed mode
        (function setupEmbedFullscreenButton() {
            const btn = document.getElementById('embedFullscreenBtn');
            if (!btn) return;
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                const container = document.getElementById('embedContainer');
                requestElementFullscreen(container);
            });
        })();

        // Video Fit/Fill Toggle (press 'Z' to toggle in fullscreen)
        let videoFitMode = localStorage.getItem('unruly_video_fit') === 'true';
        
        function toggleVideoFitMode() {
            videoFitMode = !videoFitMode;
            localStorage.setItem('unruly_video_fit', videoFitMode ? 'true' : 'false');
            
            const plyrElement = document.querySelector('.plyr');
            if (plyrElement) {
                if (videoFitMode) {
                    plyrElement.classList.add('video-fit');
                    showNotification('Video: Fit mode (letterbox)', 'info');
                } else {
                    plyrElement.classList.remove('video-fit');
                    showNotification('Video: Fill mode (full screen)', 'info');
                }
            }
        }
        
        // Apply saved fit mode preference
        function applyVideoFitMode() {
            const plyrElement = document.querySelector('.plyr');
            if (plyrElement && videoFitMode) {
                plyrElement.classList.add('video-fit');
            }
        }
        
        // Add keyboard shortcut for fit/fill toggle (Z key like VLC)
        document.addEventListener('keydown', (e) => {
            // Only respond if not typing in an input/textarea
            if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
            
            if (e.key === 'z' || e.key === 'Z') {
                toggleVideoFitMode();
            }
        });


        // Load movie data
        async function loadMovieData() {
            try {
                if (movieId) {
                    const apiUrl = typeof API_CONFIG !== 'undefined' 
                        ? API_CONFIG.BASE_URL 
                        : 'https://luganda-translated-movies-production.up.railway.app';
                    
                    const response = await fetch(`${apiUrl}/api/luganda-movies/${movieId}`);
                    const data = await response.json();
                    
                    if ((data.status === 'success' || data.success === true) && data.data) {
                        const movie = data.data;

                        // 🎬 SERIES DETECTION: If this is a series with seasons, redirect to series player
                        if (movie.contentType === 'series' || (movie.seasons && movie.seasons.length > 0)) {
                            console.log('📺 Series detected! Redirecting to series player...');
                            window.location.replace(`series-player.html?id=${movieId}`);
                            return;
                        }

                        setCurrentMovieRequiredPlan(movie.requiredPlan || 'free', movie._id || movie.id || movieId);
                        
                        // Get embed URL from either location
                        let videoUrl = movie.embedUrl || movie.video?.embedUrl || movie.video?.url;
                        const streamtapeId = movie.video?.streamtapeId;
                        // Get direct CDN URL if available (works without CORS issues)
                        const directCdnUrl = movie.video?.originalVideoPath;
                        const secureStreamPath = movie.video?.secureStreamPath;
                        const declaredProvider = movie.video?.provider;
                        
                        // Clean up URL if it exists
                        if (videoUrl) {
                            videoUrl = videoUrl.trim().replace(/\s+/g, '');
                        }
                        
                        // 🚀 SPEED: Start prefetching video immediately while UI updates
                        // Note: secure streaming URLs may require a short-lived token for paid plans, so prefetching is best-effort.
                        if (secureStreamPath) {
                            // Only prefetch free content (paid needs token)
                            if ((movie.requiredPlan || 'free') === 'free') {
                                prefetchVideoUrl(`${apiUrl}${secureStreamPath}`);
                            }
                        } else if (directCdnUrl) {
                            prefetchVideoUrl(directCdnUrl);
                        } else if (videoUrl && isDirectVideoUrl(videoUrl)) {
                            prefetchVideoUrl(videoUrl);
                        }
                        
                        // Update UI (can happen while video prefetches)
                        updateMovieInfo(movie);
                        
                        console.log('🎬 Video URL:', videoUrl);
                        console.log('🎬 Direct CDN URL:', directCdnUrl);
                        console.log('🎬 Secure Stream Path:', secureStreamPath);
                        console.log('🎬 Provider:', declaredProvider);
                        console.log('🎬 Is Direct Video URL (directCdnUrl):', directCdnUrl ? isDirectVideoUrl(directCdnUrl) : 'N/A');
                        console.log('🎬 Is Direct Video URL (videoUrl):', videoUrl ? isDirectVideoUrl(videoUrl) : 'N/A');
                        
                        // Check if video URL is valid
                        // Note: secureStreamPath and provider='archive' with archiveItemId are valid even without direct videoUrl
                        const hasSecureStream = secureStreamPath || (declaredProvider === 'archive' && movie.video?.archiveItemId);
                        if (!isValidVideoUrl(videoUrl) && !streamtapeId && !directCdnUrl && !hasSecureStream) {
                            console.log('⚠️ No valid video URL available for this movie');
                            showVideoUnavailable(movie.originalTitle);
                            if (!isNonMoviePlayback) {
                                loadRelatedMovies({
                                    genre: movie.genres?.[0],
                                    vjName: movie.vjName,
                                    currentMovieId: movie._id,
                                    limit: 8
                                });
                            }
                            return;
                        }
                        
                        // PRIORITY 0: Use direct CDN URL/MP4 if available (Archive.org CDN, Cloudflare, etc.)
                        // Direct playback is faster and more reliable than proxy streaming
                        if (directCdnUrl && isDirectVideoUrl(directCdnUrl)) {
                            console.log('✅ Direct MP4/CDN URL detected - using direct playback');
                            initPrerollAd(directCdnUrl, 'direct');
                        }
                        // PRIORITY 1: Check if videoUrl is a direct playable URL (MP4, WebM, HLS, etc.)
                        else if (videoUrl && isDirectVideoUrl(videoUrl)) {
                            console.log('✅ Direct video URL detected');
                            initPrerollAd(videoUrl, 'direct');
                        }
                        // PRIORITY 2: Secure stream path (backend proxy) if provided and no direct URL
                        else if (secureStreamPath || declaredProvider === 'archive') {
                            console.log('✅ Using secure stream proxy');
                            try {
                                const secureUrl = await getSecureArchiveStreamUrl(apiUrl, movie);
                                initPrerollAd(secureUrl, 'direct');
                            } catch (streamErr) {
                                console.warn('⚠️ Secure stream failed:', streamErr.message);
                                // Fallback to any available URL
                                if (videoUrl) {
                                    initPrerollAd(videoUrl, 'direct');
                                } else {
                                    showVideoUnavailable(movie.originalTitle || 'this movie');
                                }
                            }
                        }
                        // PRIORITY 3: Check for embed URL (Streamtape, etc.)
                        else if (videoUrl || streamtapeId) {
                            const embedSrc = videoUrl || 
                                `https://streamtape.com/e/${streamtapeId}`;
                            // For embed players, show display ad first
                            initPrerollAd(embedSrc, 'embed');
                        } else {
                            // Fall back to direct video URL
                            initPrerollAd(movie.video?.originalVideoPath || movie.streamUrl, 'direct');
                        }
                        
                        if (!isNonMoviePlayback) {
                            loadRelatedMovies({
                                genre: movie.genres?.[0],
                                vjName: movie.vjName,
                                currentMovieId: movie._id,
                                limit: 8
                            });
                        }
                    } else {
                        console.error('❌ API returned error or no data:', data);
                        document.getElementById('movieDescription').textContent = 'Unable to load movie description. Please try refreshing the page.';
                    }
                } else if (embedUrl) {
                    // Direct embed URL from query param - use pre-roll
                    initPrerollAd(embedUrl, 'embed');
                    document.getElementById('movieTitle').textContent = urlParams.get('title') || 'Now Playing';
                    if (!isStation) {
                        loadRelatedMovies('action');
                    }
                } else if (streamUrl) {
                    // For live TV/streams, skip pre-roll ad
                    loadVideoSource(streamUrl);
                    document.getElementById('movieTitle').textContent = urlParams.get('movie') || urlParams.get('station') || 'Now Playing';
                    loadingOverlay.style.display = 'none';
                    // Hide trailer button for direct streams/TV
                    const trailerBtn = document.getElementById('trailerBtn');
                    if (trailerBtn) trailerBtn.style.display = 'none';
                    if (!isStation) {
                        loadRelatedMovies('action');
                    }
                } else {
                    // No movie ID or stream URL - show unavailable message
                    showVideoUnavailable('Unknown');
                }
            } catch (error) {
                console.error('❌ Error loading movie:', error);
                showVideoUnavailable('this movie');
            }
        }

        // Load embed video (Streamtape, etc.) - Try ad-free extraction first
        async function loadEmbedVideo(url) {
            console.log('🎬 Loading video from:', url);
            
            // First, try to extract direct video URL (ad-free)
            try {
                const extractResponse = await fetch(`${API_BASE}/video/extract`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ url: url })
                });
                
                const extractData = await extractResponse.json();
                console.log('📦 Extraction result:', extractData);
                
                if (extractData.success && extractData.directUrl) {
                    console.log('✅ Direct URL extracted! Playing ad-free.');
                    
                    // Use our own player with the direct URL
                    setEmbedMode(false);
                    embedContainer.style.display = 'none';
                    video.style.display = 'block';
                    
                    // Check if it's HLS or direct MP4
                    if (extractData.type === 'hls' || extractData.directUrl.includes('.m3u8')) {
                        loadHLSSource(extractData.directUrl);
                    } else {
                        // For direct URLs that might have CORS issues, use proxy
                        const proxyUrl = `${API_BASE}/video/proxy?url=${encodeURIComponent(extractData.directUrl)}`;
                        loadVideoSource(proxyUrl);
                    }
                    
                    loadingOverlay.style.display = 'none';
                    return;
                }
            } catch (error) {
                console.warn('⚠️ Direct extraction failed, falling back to iframe:', error.message);
            }
            
            // Fallback: Use iframe embed (has ads) - SPEED OPTIMIZED
            console.log('📺 Using iframe embed (fallback)');
            setEmbedMode(true);
            
            // Hide native player, show embed container
            video.style.display = 'none';
            if (player) {
                player.destroy();
                player = null;
            }
            embedContainer.style.display = 'block';
            
            // Optimize iframe for faster loading
            embedPlayer.loading = 'eager';
            embedPlayer.setAttribute('loading', 'eager');
            embedPlayer.setAttribute('importance', 'high');
            embedPlayer.allow = 'autoplay; fullscreen; encrypted-media; picture-in-picture';
            
            // Set the embed URL
            embedPlayer.src = url;
            
            // Track if loading was hidden
            let loadingHidden = false;
            
            // Hide loading when iframe loads
            embedPlayer.onload = () => {
                if (!loadingHidden) {
                    loadingHidden = true;
                    loadingOverlay.style.display = 'none';
                }
            };
            
            // Faster fallback - hide loading after 2 seconds
            setTimeout(() => {
                if (!loadingHidden) {
                    loadingHidden = true;
                    loadingOverlay.style.display = 'none';
                }
            }, 2000);
        }

        // Load HLS source - SPEED OPTIMIZED
        function loadHLSSource(url) {
            if (Hls.isSupported()) {
                const hls = new Hls({
                    maxBufferLength: 60,          // 60 seconds buffer
                    maxMaxBufferLength: 120,      // Max 2 minutes
                    maxBufferSize: 60 * 1000 * 1000, // 60MB
                    enableWorker: true,
                    startLevel: -1,               // Auto quality
                    abrBandWidthFactor: 0.95,     // Aggressive upgrade
                    fragLoadingMaxRetry: 6,
                    startFragPrefetch: true       // Prefetch first fragment
                });
                hls.loadSource(url);
                hls.attachMedia(video);
                
                // Hide loading on first fragment
                hls.on(Hls.Events.FRAG_LOADED, () => {
                    loadingOverlay.style.display = 'none';
                });
                
                hls.on(Hls.Events.MANIFEST_PARSED, () => {
                    initPlayer();
                    loadingOverlay.style.display = 'none';
                });
                hls.on(Hls.Events.ERROR, (event, data) => {
                    console.error('HLS error:', data);
                    if (data.fatal) {
                        // Fallback to iframe on HLS error
                        loadEmbedFallback(url);
                    }
                });
            } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
                video.src = url;
                initPlayer();
                loadingOverlay.style.display = 'none';
            }
        }

        // Fallback to iframe embed
        function loadEmbedFallback(originalUrl) {
            console.log('📺 Falling back to iframe embed');
            setEmbedMode(true);
            video.style.display = 'none';
            embedContainer.style.display = 'block';
            embedPlayer.src = originalUrl;
            loadingOverlay.style.display = 'none';
        }

        // Convert Streamtape URL to embed URL
        function getStreamtapeEmbedUrl(url) {
            if (!url) return null;
            
            // If already an embed URL, return as is
            if (url.includes('/e/')) return url;
            
            // Extract video ID from various Streamtape URL formats
            // https://streamtape.com/v/VIDEOID/title
            // https://streamtape.to/v/VIDEOID/title
            const match = url.match(/streamtape\.(com|to|net)\/v\/([a-zA-Z0-9]+)/);
            if (match) {
                return `https://streamtape.com/e/${match[2]}`;
            }
            
            return url;
        }

        // Update movie information on page
        async function updateMovieInfo(movie) {
            document.getElementById('movieTitle').textContent = movie.originalTitle || movie.title;
            document.getElementById('movieDescription').textContent = movie.plot || movie.description || 'No description available.';
            
            const poster = document.getElementById('moviePoster');
            poster.src = movie.poster || 'assets/images/placeholder-poster.jpg';
            poster.alt = movie.originalTitle || movie.title;
            
            // Update meta tags for sharing
            document.querySelector('meta[property="og:title"]').content = movie.originalTitle || movie.title;
            document.querySelector('meta[property="og:description"]').content = movie.plot || movie.description || '';
            document.querySelector('meta[property="og:image"]').content = movie.poster || '';
            document.querySelector('meta[property="og:url"]').content = window.location.href;
            document.title = `${movie.originalTitle || movie.title} - Unruly Movies`;
            
            // Update badges
            if (movie.rating?.translationRating) {
                document.getElementById('movieRating').querySelector('span:last-child').textContent = movie.rating.translationRating.toFixed(1);
            }
            if (movie.releaseYear) {
                document.getElementById('movieYear').querySelector('span:last-child').textContent = movie.releaseYear;
            }
            if (movie.video?.quality) {
                document.getElementById('movieQuality').textContent = movie.video.quality.toUpperCase();
            }
            if (movie.video?.duration) {
                document.getElementById('movieDuration').querySelector('span:last-child').textContent = movie.video.duration;
            }
            
            // Update genres
            const genresContainer = document.getElementById('movieGenres');
            if (genresContainer && movie.genres && Array.isArray(movie.genres) && movie.genres.length > 0) {
                genresContainer.innerHTML = movie.genres.map(genre => 
                    `<span class="genre-badge" style="padding: 6px 12px; background: rgba(124, 252, 0, 0.1); border: 1px solid rgba(124, 252, 0, 0.3); border-radius: 16px; font-size: 13px; color: #7CFC00; font-weight: 500;">${genre}</span>`
                ).join('');
                genresContainer.style.display = 'flex';
            } else if (genresContainer) {
                genresContainer.style.display = 'none';
            }
            
            // Update VJ info
            if (!isNonMoviePlayback) {
                if (movie.vjName) {
                    document.getElementById('vjName').textContent = `VJ ${movie.vjName}`;
                }
                if (movie.vjAvatar) {
                    document.getElementById('vjAvatar').src = movie.vjAvatar;
                }
            }
            
            // Setup trailer button if movie has TMDB ID (hide for TV stations)
            const trailerBtn = document.getElementById('trailerBtn');
            
            // Hide trailer button for TV stations
            if (isNonMoviePlayback || isSeries) {
                if (trailerBtn) {
                    trailerBtn.style.display = 'none';
                }
            } else {
                // For movies, setup trailer functionality
                const tmdbId = movie.tmdbId || movie.metaData?.tmdbId || movie.externalIds?.tmdbId || movie.tmdb_id;
                console.log('🎬 Trailer setup - TMDB ID:', tmdbId, 'Movie data:', movie);
                
                if (trailerBtn) {
                    if (tmdbId) {
                        trailerBtn.style.display = 'flex';
                        trailerBtn.disabled = false;
                        trailerBtn.classList.remove('disabled');
                        trailerBtn.onclick = async () => {
                            console.log('🎬 Trailer button clicked, TMDB ID:', tmdbId);
                            trailerBtn.disabled = true;
                            trailerBtn.innerHTML = `
                                <svg class="spinner" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="animation: spin 1s linear infinite;">
                                    <circle cx="12" cy="12" r="10" stroke-dasharray="32" stroke-dashoffset="12"></circle>
                                </svg>
                                Loading...
                            `;
                            
                            try {
                                if (typeof trailerPlayer !== 'undefined' && trailerPlayer) {
                                    await trailerPlayer.playTrailer(tmdbId, movie.originalTitle || movie.title);
                                } else {
                                    throw new Error('TrailerPlayer not initialized');
                                }
                            } catch (error) {
                                console.error('Error playing trailer:', error);
                                showNotification('Trailer not available for this movie', 'error');
                            } finally {
                                trailerBtn.disabled = false;
                                trailerBtn.innerHTML = `
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polygon points="5 3 19 12 5 21 5 3"></polygon>
                                    </svg>
                                    Watch Trailer
                                `;
                            }
                        };
                    } else {
                        trailerBtn.style.display = 'none';
                    }
                }
            }
            
            // Show episodes section for series
            if (movie.type === 'series' || isSeries) {
                loadEpisodes(movie);
            }
            
            // Setup download button based on allowDownload setting AND user permission
            const downloadBtn = document.getElementById('downloadBtn');
            if (downloadBtn && !isNonMoviePlayback) {
                // Check if movie allows download
                if (movie.allowDownload && movie.video?.embedUrl) {
                    // Check if user has download permission
                    const token = localStorage.getItem('token') || sessionStorage.getItem('token');
                    if (token) {
                        try {
                            const apiUrl = typeof API_CONFIG !== 'undefined' ? API_CONFIG.BASE_URL : 'https://luganda-translated-movies-production.up.railway.app';
                            const userResp = await fetch(`${apiUrl}/api/auth/me`, {
                                headers: { 'Authorization': `Bearer ${token}` }
                            });
                            const userData = await userResp.json();
                            
                            if (userData.success && userData.data?.canDownload) {
                                downloadBtn.style.display = 'flex';
                                downloadBtn.onclick = () => {
                                    const videoUrl = movie.video.embedUrl;
                                    const fileName = `${movie.title || movie.originalTitle || 'movie'}.mp4`;
                                    
                                    // For direct video URLs, initiate download
                                    if (videoUrl.includes('.mp4') || videoUrl.includes('.mkv') || videoUrl.includes('.webm')) {
                                        const link = document.createElement('a');
                                        link.href = videoUrl;
                                        link.download = fileName;
                                        link.target = '_blank';
                                        document.body.appendChild(link);
                                        link.click();
                                        document.body.removeChild(link);
                                        showNotification('Download started!', 'success');
                                    } else if (videoUrl.includes('streamtape.') || videoUrl.includes('doodstream.') || videoUrl.includes('filemoon.')) {
                                        // For embed URLs, open in new tab with instructions
                                        window.open(videoUrl, '_blank');
                                        showNotification('Opening video source - use browser download option', 'info');
                                    } else {
                                        // Fallback: open video URL
                                        window.open(videoUrl, '_blank');
                                        showNotification('Opening video source', 'info');
                                    }
                                };
                            } else {
                                downloadBtn.style.display = 'none';
                            }
                        } catch (err) {
                            console.log('Could not verify download permission:', err);
                            downloadBtn.style.display = 'none';
                        }
                    } else {
                        downloadBtn.style.display = 'none';
                    }
                } else {
                    downloadBtn.style.display = 'none';
                }
            }
        }

        // Load video source
        function loadVideoSource(url) {
            if (!url) {
                loadingOverlay.style.display = 'none';
                return;
            }
            
            // Check if it's a Streamtape or other embed URL
            if (url.includes('streamtape.') || url.includes('doodstream.') || 
                url.includes('filemoon.') || url.includes('/e/') || url.includes('/embed/')) {
                const embedSrc = getStreamtapeEmbedUrl(url);
                loadEmbedVideo(embedSrc);
                return;
            }
            
            // 🎬 MKV SUPPORT: Use backend remux endpoint for MKV files
            // Remux converts MKV to MP4 container on-the-fly for better browser compatibility
            const urlLower = url.toLowerCase();
            if (urlLower.includes('.mkv')) {
                console.log('🎬 MKV detected - using remux for browser compatibility');
                const apiUrl = typeof API_CONFIG !== 'undefined' 
                    ? API_CONFIG.BASE_URL 
                    : 'https://luganda-translated-movies-production.up.railway.app';
                // Use remux endpoint which converts MKV->MP4 on-the-fly
                url = `${apiUrl}/api/video/remux?url=${encodeURIComponent(url)}`;
            }
            
            // Convert cloud video URLs to direct playable format
            const cloudVideo = convertCloudVideoUrl(url);
            let videoUrl = cloudVideo.url;
            let videoType = cloudVideo.type;
            
            // Set poster if available from cloud provider
            if (cloudVideo.poster && video) {
                video.poster = cloudVideo.poster;
            }
            
            console.log('🎬 Loading video:', videoType, videoUrl);
            
            setEmbedMode(false);
            
            // Show native player, hide embed
            video.style.display = 'block';
            embedContainer.style.display = 'none';
            
            // IMPORTANT: Remove crossorigin attribute to avoid CORS issues
            video.removeAttribute('crossorigin');
            
            // Initialize Plyr
            initPlyr();
            
            // Check if HLS stream (either .m3u8 extension or detected as HLS type)
            if (videoUrl.includes('.m3u8') || videoType === 'hls') {
                if (Hls.isSupported()) {
                    // Optimized HLS config for faster loading
                    const hls = new Hls({
                        enableWorker: true,           // Use web worker for parsing
                        lowLatencyMode: false,        // Disable for VOD (better buffering)
                        maxBufferLength: 60,          // Buffer 60 seconds ahead
                        maxMaxBufferLength: 120,      // Max 2 minutes buffer
                        maxBufferSize: 60 * 1000 * 1000, // 60MB buffer
                        maxBufferHole: 0.5,           // Allow 0.5s gaps
                        startLevel: -1,               // Auto quality selection
                        abrEwmaFastLive: 3,           // Fast quality switching
                        abrEwmaSlowLive: 9,
                        abrEwmaFastVoD: 3,
                        abrEwmaSlowVoD: 9,
                        abrBandWidthFactor: 0.95,     // Aggressive quality upgrade
                        abrBandWidthUpFactor: 0.7,
                        fragLoadingTimeOut: 20000,    // Longer timeout
                        manifestLoadingTimeOut: 10000,
                        levelLoadingTimeOut: 10000,
                        fragLoadingMaxRetry: 6,       // More retries
                        startFragPrefetch: true       // Prefetch first fragment
                    });
                    
                    hls.loadSource(videoUrl);
                    hls.attachMedia(video);
                    
                    // Hide loading early - on first fragment load
                    hls.on(Hls.Events.FRAG_LOADED, () => {
                        loadingOverlay.style.display = 'none';
                    });
                    
                    hls.on(Hls.Events.MANIFEST_PARSED, () => {
                        console.log('🎬 HLS manifest parsed, levels:', hls.levels.length);
                        loadingOverlay.style.display = 'none';
                    });
                    
                    hls.on(Hls.Events.ERROR, (event, data) => {
                        if (data.fatal) {
                            console.error('HLS Error:', data);
                            
                            // Try fallback URL if available (e.g., MP4 from Cloudflare)
                            if (cloudVideo.fallbackUrl) {
                                console.log('⚠️ HLS failed, trying fallback MP4:', cloudVideo.fallbackUrl);
                                hls.destroy();
                                video.src = cloudVideo.fallbackUrl;
                                video.load();
                                loadingOverlay.style.display = 'none';
                            } else {
                                // Try to recover
                                if (data.type === Hls.ErrorTypes.NETWORK_ERROR) {
                                    hls.startLoad();
                                } else if (data.type === Hls.ErrorTypes.MEDIA_ERROR) {
                                    hls.recoverMediaError();
                                } else {
                                    loadingOverlay.style.display = 'none';
                                    showMessage('Video playback error. Please try again.', 'error');
                                }
                            }
                        }
                    });
                    
                    window.hlsPlayer = hls;
                } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
                    // Safari native HLS support
                    video.src = videoUrl;
                    video.preload = 'auto';
                    video.addEventListener('loadedmetadata', () => {
                        loadingOverlay.style.display = 'none';
                    }, { once: true });
                    
                    // Fallback on error for Safari
                    video.addEventListener('error', () => {
                        if (cloudVideo.fallbackUrl) {
                            console.log('⚠️ Native HLS failed, trying fallback:', cloudVideo.fallbackUrl);
                            video.src = cloudVideo.fallbackUrl;
                            video.load();
                        }
                    }, { once: true });
                }
            } else {
                // Regular video file (MP4, MKV, WebM, etc.)
                console.log('🎬 Loading direct video file:', videoUrl);
                
                // Clear any previous source
                video.pause();
                video.removeAttribute('src');
                video.load();
                
                // Set video attributes for optimal playback
                video.preload = 'auto';
                video.setAttribute('preload', 'auto');
                video.setAttribute('playsinline', '');
                video.playsInline = true;
                video.autobuffer = true;
                
                // Track load attempts
                let loadAttempts = 0;
                const maxAttempts = 3;
                
                // Function to try loading the video
                function attemptLoad(srcUrl) {
                    loadAttempts++;
                    console.log(`🎬 Load attempt ${loadAttempts}/${maxAttempts}: ${srcUrl.substring(0, 80)}...`);
                    
                    video.src = srcUrl;
                    video.load();
                }
                
                // Hide loading as soon as we have metadata
                const onLoadedMetadata = () => {
                    console.log('✅ Video metadata loaded');
                    loadingOverlay.style.display = 'none';
                };
                
                const onCanPlay = () => {
                    console.log('✅ Video can play');
                    loadingOverlay.style.display = 'none';
                };
                
                const onProgress = () => {
                    if (video.buffered.length > 0) {
                        const bufferedEnd = video.buffered.end(0);
                        console.log(`📊 Buffered: ${bufferedEnd.toFixed(2)}s`);
                        if (bufferedEnd > 0.5) {
                            loadingOverlay.style.display = 'none';
                        }
                    }
                };
                
                const onError = (e) => {
                    console.error('❌ Video load error:', e, video.error);
                    
                    // Try fallback URL
                    if (cloudVideo.fallbackUrl && video.src !== cloudVideo.fallbackUrl && loadAttempts < maxAttempts) {
                        console.log('⚠️ Trying fallback URL:', cloudVideo.fallbackUrl);
                        attemptLoad(cloudVideo.fallbackUrl);
                        return;
                    }
                    
                    // If remux failed, try stream-proxy as fallback for MKV
                    const currentUrl = video.src || videoUrl;
                    if (currentUrl.includes('/remux?') && loadAttempts < maxAttempts) {
                        const apiUrl = typeof API_CONFIG !== 'undefined' ? API_CONFIG.BASE_URL : 'https://luganda-translated-movies-production.up.railway.app';
                        const originalUrl = new URLSearchParams(currentUrl.split('?')[1]).get('url');
                        if (originalUrl) {
                            console.log('⚠️ Remux failed, trying stream-proxy fallback...');
                            const proxyUrl = `${apiUrl}/api/video/stream-proxy?url=${encodeURIComponent(originalUrl)}`;
                            attemptLoad(proxyUrl);
                            return;
                        }
                    }
                    
                    // Retry with same URL (network issues)
                    if (loadAttempts < maxAttempts) {
                        console.log('⚠️ Retrying same URL...');
                        setTimeout(() => attemptLoad(videoUrl), 1000);
                        return;
                    }
                    
                    loadingOverlay.style.display = 'none';
                    
                    // Check if it's a format issue (MKV not supported in some browsers)
                    const errorUrlLower = videoUrl.toLowerCase();
                    if (errorUrlLower.includes('.mkv') || errorUrlLower.includes('/remux')) {
                        // Show helpful message for MKV/remux files
                        showVideoError('MKV video failed to load. The server may be processing the video. Please try again in a moment, or download the video to watch locally.', videoUrl);
                    } else {
                        showVideoError('Error loading video. The file may be unavailable or your browser may not support this format.', videoUrl);
                    }
                };
                
                // Add event listeners
                video.addEventListener('loadedmetadata', onLoadedMetadata, { once: true });
                video.addEventListener('canplay', onCanPlay, { once: true });
                video.addEventListener('progress', onProgress, { once: true });
                video.addEventListener('error', onError, { once: true });
                
                // Start loading
                attemptLoad(videoUrl);
            }
        }
        
        // Show video error with download option
        function showVideoError(message, downloadUrl) {
            const videoContainer = document.querySelector('.video-wrapper');
            if (!videoContainer) return;
            
            // Create error overlay
            const errorDiv = document.createElement('div');
            errorDiv.className = 'video-error-overlay';
            errorDiv.innerHTML = `
                <div style="text-align: center; padding: 40px; background: rgba(0,0,0,0.9); border-radius: 10px; max-width: 500px;">
                    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#ff6b6b" stroke-width="2" style="margin-bottom: 20px;">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                    <h3 style="color: #fff; margin-bottom: 15px;">Video Playback Issue</h3>
                    <p style="color: #ccc; margin-bottom: 20px; line-height: 1.6;">${message}</p>
                    ${downloadUrl ? `
                        <a href="${downloadUrl}" download class="btn-admin" style="display: inline-flex; align-items: center; gap: 8px; text-decoration: none;">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                <polyline points="7 10 12 15 17 10"></polyline>
                                <line x1="12" y1="15" x2="12" y2="3"></line>
                            </svg>
                            Download Video
                        </a>
                    ` : ''}
                </div>
            `;
            errorDiv.style.cssText = 'position: absolute; top: 0; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; z-index: 100;';
            
            videoContainer.style.position = 'relative';
            videoContainer.appendChild(errorDiv);
        }

        // Load episodes for series
        function loadEpisodes(movie) {
            const episodesSection = document.getElementById('episodesSection');
            const episodesGrid = document.getElementById('episodesGrid');
            
            episodesSection.style.display = 'block';
            episodesGrid.innerHTML = '';
            
            const episodes = movie.episodes || [];
            const numEpisodes = episodes.length || 10;
            
            for (let i = 0; i < numEpisodes; i++) {
                const ep = episodes[i] || {};
                const card = document.createElement('div');
                card.className = `episode-card ${i === 0 ? 'active' : ''}`;
                card.innerHTML = `
                    <div class="episode-thumb">
                        <img src="${ep.thumbnail || movie.poster || 'assets/images/placeholder-episode.jpg'}" alt="Episode ${i + 1}">
                        <div class="episode-play-icon">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                                <polygon points="5 3 19 12 5 21 5 3"></polygon>
                            </svg>
                        </div>
                    </div>
                    <div class="episode-info">
                        <div class="episode-number">Episode ${i + 1}</div>
                        <div class="episode-title">${ep.title || `Episode ${i + 1}`}</div>
                        <div class="episode-duration">${ep.duration || '45 min'}</div>
                    </div>
                `;
                
                card.addEventListener('click', () => {
                    document.querySelectorAll('.episode-card').forEach(c => c.classList.remove('active'));
                    card.classList.add('active');
                    if (ep.url) {
                        loadVideoSource(ep.url);
                    }
                });
                
                episodesGrid.appendChild(card);
            }
        }

        // Load related movies
        async function loadRelatedMovies(input) {
            const grid = document.getElementById('relatedGrid');

            if (isNonMoviePlayback) {
                const relatedSection = document.getElementById('relatedSection');
                if (relatedSection) relatedSection.style.display = 'none';
                if (grid) grid.innerHTML = '';
                return;
            }

            const relatedSection = document.getElementById('relatedSection');
            if (relatedSection) relatedSection.style.display = '';

            const options = typeof input === 'string'
                ? { genre: input, limit: 8 }
                : (input || {});

            const limit = Number(options.limit) > 0 ? Number(options.limit) : 8;
            const genre = options.genre ? String(options.genre) : null;
            const vjName = options.vjName ? String(options.vjName) : null;
            const currentMovieId = options.currentMovieId ? String(options.currentMovieId) : null;

            const uniqById = (movies) => {
                const seen = new Set();
                return (movies || []).filter(m => {
                    const id = m && (m._id || m.id);
                    if (!id) return false;
                    if (seen.has(id)) return false;
                    seen.add(id);
                    return true;
                });
            };

            const shuffle = (arr) => {
                const a = [...(arr || [])];
                for (let i = a.length - 1; i > 0; i--) {
                    const j = Math.floor(Math.random() * (i + 1));
                    [a[i], a[j]] = [a[j], a[i]];
                }
                return a;
            };
            
            try {
                const apiUrl = typeof API_CONFIG !== 'undefined' 
                    ? API_CONFIG.BASE_URL 
                    : 'https://luganda-translated-movies-production.up.railway.app';

                const results = [];

                // Prefer same VJ first
                if (vjName) {
                    try {
                        const vjRes = await fetch(`${apiUrl}/api/luganda-movies/vj/${encodeURIComponent(vjName)}?limit=${Math.max(limit * 2, 12)}`);
                        const vjData = await vjRes.json();
                        if (vjData?.success && Array.isArray(vjData.data)) {
                            results.push(...vjData.data);
                        }
                    } catch (e) {
                        console.warn('Related by VJ failed:', e);
                    }
                }

                // Then same genre
                if (genre) {
                    try {
                        const gRes = await fetch(`${apiUrl}/api/luganda-movies/genre/${encodeURIComponent(genre)}?limit=${Math.max(limit * 2, 12)}`);
                        const gData = await gRes.json();
                        if (gData?.success && Array.isArray(gData.data)) {
                            results.push(...gData.data);
                        }
                    } catch (e) {
                        console.warn('Related by genre failed:', e);
                    }
                }

                // Fallback: latest
                if (results.length < limit) {
                    const latestRes = await fetch(`${apiUrl}/api/luganda-movies/latest?limit=${Math.max(limit * 2, 12)}`);
                    const latestData = await latestRes.json();
                    if ((latestData?.status === 'success' || latestData?.success === true) && Array.isArray(latestData.data)) {
                        results.push(...latestData.data);
                    }
                }

                let finalMovies = uniqById(results);
                if (currentMovieId) {
                    finalMovies = finalMovies.filter(m => String(m._id || m.id) !== currentMovieId);
                }
                finalMovies = shuffle(finalMovies).slice(0, limit);

                if (finalMovies.length > 0) {
                    grid.innerHTML = finalMovies.map(movie => `
                        <a href="player.html?id=${movie._id}" class="movie-card">
                            <div class="movie-card-poster">
                                <img src="${movie.poster || 'assets/images/placeholder-poster.jpg'}" alt="${movie.originalTitle}" loading="lazy">
                                <div class="movie-card-overlay">
                                    <div class="play-circle">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                            <polygon points="5 3 19 12 5 21 5 3"></polygon>
                                        </svg>
                                    </div>
                                </div>
                                <span class="movie-card-badge">${movie.video?.quality?.toUpperCase() || 'HD'}</span>
                            </div>
                            <div class="movie-card-info">
                                <div class="movie-card-title">${movie.originalTitle}</div>
                                <div class="movie-card-vj">VJ ${movie.vjName || 'Unknown'}</div>
                            </div>
                        </a>
                    `).join('');
                } else {
                    grid.innerHTML = '<p style="color: #888; text-align: center; grid-column: 1/-1;">No recommendations available</p>';
                }
            } catch (error) {
                console.error('Error loading related movies:', error);
                grid.innerHTML = '<p style="color: #888; text-align: center; grid-column: 1/-1;">Unable to load recommendations</p>';
            }
        }

        // Show more / Show less description
        const showMoreBtn = document.getElementById('showMoreBtn');
        const description = document.getElementById('movieDescription');
        
        showMoreBtn.addEventListener('click', () => {
            description.classList.toggle('collapsed');
            showMoreBtn.textContent = description.classList.contains('collapsed') ? 'Show more' : 'Show less';
        });

        // Header hide on scroll
        let lastScroll = 0;
        const header = document.getElementById('playerHeader');
        
        window.addEventListener('scroll', () => {
            const currentScroll = window.pageYOffset;
            
            if (currentScroll > lastScroll && currentScroll > 100) {
                header.classList.add('hidden');
            } else {
                header.classList.remove('hidden');
            }
            
            lastScroll = currentScroll;
        });

        // Watchlist button
        const watchlistBtn = document.getElementById('watchlistBtn');
        watchlistBtn.addEventListener('click', () => {
            if (typeof WatchlistManager !== 'undefined') {
                const movieData = {
                    id: movieId,
                    title: document.getElementById('movieTitle').textContent,
                    poster: document.getElementById('moviePoster').src
                };
                WatchlistManager.toggleWatchlist(movieData);
                
                const isInList = WatchlistManager.isInWatchlist(movieId);
                watchlistBtn.innerHTML = isInList ? `
                    <svg viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2">
                        <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                    </svg>
                    In Watchlist
                ` : `
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                    </svg>
                    Add to Watchlist
                `;
            }
        });

        // Like button functionality
        const likeBtn = document.getElementById('likeBtn');
        let isLiked = localStorage.getItem(`liked_${movieId}`) === 'true';
        
        // Update like button initial state
        function updateLikeButton() {
            likeBtn.innerHTML = isLiked ? `
                <svg viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
                Liked
            ` : `
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
                Like
            `;
            likeBtn.classList.toggle('liked', isLiked);
        }
        
        updateLikeButton();
        
        likeBtn.addEventListener('click', () => {
            isLiked = !isLiked;
            localStorage.setItem(`liked_${movieId}`, isLiked);
            updateLikeButton();
            
            // Visual feedback
            likeBtn.style.transform = 'scale(1.1)';
            setTimeout(() => {
                likeBtn.style.transform = 'scale(1)';
            }, 150);
        });

        // Wait for trailer player to be ready
        function waitForTrailerPlayer(callback, maxRetries = 10) {
            if (typeof trailerPlayer !== 'undefined' && trailerPlayer) {
                callback();
            } else if (maxRetries > 0) {
                setTimeout(() => waitForTrailerPlayer(callback, maxRetries - 1), 100);
            } else {
                console.warn('TrailerPlayer not available after retries');
                callback(); // Continue anyway
            }
        }

        // Initialize
        waitForTrailerPlayer(() => {
            console.log('✅ TrailerPlayer ready, loading movie data...');
            loadMovieData();
        });
        
        // Failsafe: hide loading overlay after 15 seconds if something goes wrong
        setTimeout(() => {
            const overlay = document.getElementById('loadingOverlay');
            if (overlay && overlay.style.display !== 'none') {
                console.warn('⚠️ Failsafe: hiding loading overlay after timeout');
                overlay.style.display = 'none';
            }
        }, 15000);
        
        // Load comments when movie is loaded
        if (movieId) {
            loadComments(movieId);
            setupCommentForm();
        }

        // ===================================
        // Quality Selector
        // ===================================
        
        let currentQuality = localStorage.getItem('preferredQuality') || 'auto';
        
        // Setup quality selector (must be after currentQuality declaration)
        setupQualitySelector();
        
        function setupQualitySelector() {
            const qualityBtn = document.getElementById('qualityBtn');
            const qualityDropdown = document.getElementById('qualityDropdown');
            const qualitySelector = document.getElementById('qualitySelector');
            const currentQualityEl = document.getElementById('currentQuality');
            
            if (!qualityBtn || !qualityDropdown) return;
            
            // Set initial quality display
            if (currentQualityEl) {
                currentQualityEl.textContent = currentQuality === 'auto' ? 'Auto' : currentQuality;
            }
            
            // Mark current quality as active
            const options = qualityDropdown.querySelectorAll('.quality-option');
            options.forEach(opt => {
                if (opt.dataset.quality === currentQuality) {
                    opt.classList.add('active');
                }
            });
            
            // Toggle dropdown
            qualityBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                qualitySelector.classList.toggle('open');
            });
            
            // Quality option click
            options.forEach(option => {
                option.addEventListener('click', () => {
                    const quality = option.dataset.quality;
                    
                    // Update UI
                    options.forEach(opt => opt.classList.remove('active'));
                    option.classList.add('active');
                    
                    if (currentQualityEl) {
                        currentQualityEl.textContent = quality === 'auto' ? 'Auto' : quality;
                    }
                    
                    // Save preference
                    currentQuality = quality;
                    localStorage.setItem('preferredQuality', quality);
                    
                    // Apply quality change
                    applyQuality(quality);
                    
                    // Close dropdown
                    qualitySelector.classList.remove('open');
                    
                    showNotification(`Quality set to ${quality === 'auto' ? 'Auto' : quality}`, 'success');
                });
            });
            
            // Close dropdown when clicking outside
            document.addEventListener('click', (e) => {
                if (!qualitySelector.contains(e.target)) {
                    qualitySelector.classList.remove('open');
                }
            });
        }
        
        function applyQuality(quality) {
            // Apply quality to HLS player if available
            if (typeof Hls !== 'undefined' && window.hlsInstance) {
                const hls = window.hlsInstance;
                
                if (quality === 'auto') {
                    hls.currentLevel = -1; // Auto
                } else {
                    // Find matching level
                    const targetHeight = parseInt(quality);
                    const levels = hls.levels || [];
                    
                    for (let i = 0; i < levels.length; i++) {
                        if (levels[i].height === targetHeight || levels[i].height <= targetHeight) {
                            hls.currentLevel = i;
                            break;
                        }
                    }
                }
            }
            
            // For Plyr player
            if (player && player.quality !== undefined) {
                if (quality !== 'auto') {
                    const qualityValue = parseInt(quality);
                    player.quality = qualityValue;
                }
            }
            
            console.log(`📺 Quality set to: ${quality}`);
        }

        // ===================================
        // Comments System
        // ===================================
        
        // Load comments from localStorage (or API when available)
        async function loadComments(movieId) {
            const loadingEl = document.getElementById('commentsLoading');
            const noCommentsEl = document.getElementById('noComments');
            const commentsListEl = document.getElementById('commentsList');
            const loadMoreBtn = document.getElementById('loadMoreComments');
            const commentCountEl = document.getElementById('commentCount');
            
            try {
                // Try to load from API first
                const apiUrl = typeof API_CONFIG !== 'undefined' 
                    ? API_CONFIG.BASE_URL 
                    : 'https://luganda-translated-movies-production.up.railway.app';
                
                try {
                    const response = await fetch(`${apiUrl}/api/comments/movie/${movieId}?page=${commentsPage}&limit=${commentsPerPage}`);
                    const data = await response.json();
                    
                    if (data.status === 'success' && data.data?.comments) {
                        allComments = data.data.comments;
                        commentCountEl.textContent = `${data.data.pagination?.total || allComments.length} comments`;
                    }
                } catch (apiError) {
                    console.log('Comments API not available, using localStorage');
                    // Load from localStorage as fallback
                    const localComments = JSON.parse(localStorage.getItem(`comments_${movieId}`) || '[]');
                    allComments = localComments;
                    commentCountEl.textContent = `${allComments.length} comments`;
                }
                
                if (loadingEl) loadingEl.style.display = 'none';
                
                if (allComments.length === 0) {
                    if (noCommentsEl) noCommentsEl.style.display = 'flex';
                    return;
                }
                
                if (noCommentsEl) noCommentsEl.style.display = 'none';
                renderComments(allComments);
                
            } catch (error) {
                console.error('Error loading comments:', error);
                if (loadingEl) loadingEl.style.display = 'none';
                if (noCommentsEl) noCommentsEl.style.display = 'flex';
            }
        }
        
        // Render comments to the page
        function renderComments(comments) {
            const listEl = document.getElementById('commentsList');
            if (!listEl) return;
            
            // Clear loading and no comments elements
            const loadingEl = listEl.querySelector('.comments-loading');
            const noCommentsEl = listEl.querySelector('.no-comments');
            if (loadingEl) loadingEl.style.display = 'none';
            if (noCommentsEl) noCommentsEl.style.display = 'none';
            
            // Remove existing comments
            listEl.querySelectorAll('.comment-item').forEach(el => el.remove());
            
            comments.forEach(comment => {
                const commentEl = createCommentElement(comment);
                listEl.appendChild(commentEl);
            });
        }
        
        // Create a comment element
        function createCommentElement(comment) {
            const div = document.createElement('div');
            div.className = 'comment-item';
            div.dataset.id = comment.id || comment._id;
            
            const avatar = comment.user?.avatar || comment.avatar || `https://api.dicebear.com/7.x/avataaars/svg?seed=${comment.user?.name || comment.author || 'user'}`;
            const author = comment.user?.fullName || comment.user?.name || comment.author || 'Anonymous';
            const date = comment.createdAt ? formatTimeAgo(new Date(comment.createdAt)) : 'Just now';
            const rating = comment.rating || 0;
            const likes = comment.likeCount || comment.likes?.length || 0;
            const isLiked = comment.userLiked || localStorage.getItem(`comment_liked_${comment.id || comment._id}`) === 'true';
            const isAdmin = comment.user?.role === 'admin';
            
            // Admin badge HTML with crown icon
            const adminBadgeHtml = isAdmin ? `
                <span class="admin-badge">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M5 16L3 5l5.5 5L12 4l3.5 6L21 5l-2 11H5zm14 3c0 .6-.4 1-1 1H6c-.6 0-1-.4-1-1v-1h14v1z"/>
                    </svg>
                    Admin
                </span>
            ` : '';
            
            div.innerHTML = `
                <div class="comment-avatar">
                    <img src="${avatar}" alt="${author}">
                </div>
                <div class="comment-content">
                    <div class="comment-header">
                        <span class="comment-author">${author}</span>
                        ${adminBadgeHtml}
                        ${rating > 0 ? `
                        <div class="comment-rating">
                            ${Array(5).fill(0).map((_, i) => `<span class="star">${i < rating ? '★' : '☆'}</span>`).join('')}
                        </div>
                        ` : ''}
                        <span class="comment-date">${date}</span>
                    </div>
                    <p class="comment-text">${escapeHtml(comment.content || comment.text)}</p>
                    <div class="comment-actions-row">
                        <button class="comment-action-btn ${isLiked ? 'liked' : ''}" onclick="toggleCommentLike('${comment.id || comment._id}')">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="${isLiked ? 'currentColor' : 'none'}" stroke="currentColor" stroke-width="2">
                                <path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"></path>
                            </svg>
                            <span>${likes}</span>
                        </button>
                        <button class="comment-action-btn" onclick="replyToComment('${comment.id || comment._id}', '${author}')">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                            </svg>
                            Reply
                        </button>
                    </div>
                </div>
            `;
            
            return div;
        }
        
        // Setup comment form interactions
        function setupCommentForm() {
            const input = document.getElementById('commentInput');
            const actions = document.getElementById('commentActions');
            const cancelBtn = document.getElementById('cancelComment');
            const submitBtn = document.getElementById('submitComment');
            const avatarEl = document.getElementById('commentUserAvatar');
            
            console.log('📝 Setting up comment form:', { input, actions, cancelBtn, submitBtn });
            
            // Show actions when input is focused
            if (input) {
                input.addEventListener('focus', () => {
                    if (actions) actions.style.display = 'flex';
                    input.rows = 3;
                });
                
                // Auto-resize textarea
                input.addEventListener('input', () => {
                    input.style.height = 'auto';
                    input.style.height = Math.min(input.scrollHeight, 150) + 'px';
                });
                
                // Submit on Ctrl+Enter
                input.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
                        e.preventDefault();
                        submitComment();
                    }
                });
            }
            
            // Cancel button
            if (cancelBtn) {
                cancelBtn.addEventListener('click', () => {
                    if (input) {
                        input.value = '';
                        input.rows = 1;
                        input.style.height = 'auto';
                    }
                    if (actions) actions.style.display = 'none';
                    // Clear rating
                    document.querySelectorAll('.star-rating-input input').forEach(r => r.checked = false);
                });
            }
            
            // Submit button
            if (submitBtn) {
                submitBtn.addEventListener('click', () => submitComment());
            }
            
            // Update avatar if user is logged in
            const user = JSON.parse(localStorage.getItem('user') || '{}');
            if (user.picture && avatarEl) {
                avatarEl.innerHTML = `<img src="${user.picture}" alt="${user.name || 'User'}">`;
            }
        }
        
        // Submit a new comment
        async function submitComment() {
            console.log('📝 submitComment called');
            const input = document.getElementById('commentInput');
            const content = input?.value.trim();
            
            console.log('📝 Comment content:', content);
            
            if (!content) {
                showNotification('Please write a comment', 'error');
                return;
            }
            
            // Get selected rating
            const ratingInput = document.querySelector('.star-rating-input input:checked');
            const rating = ratingInput ? parseInt(ratingInput.value) : 0;
            console.log('📝 Rating:', rating);
            
            // Get user info
            const user = JSON.parse(localStorage.getItem('user') || '{}');
            const token = localStorage.getItem('token');
            
            const newComment = {
                id: 'comment_' + Date.now(),
                movieId: movieId,
                author: user.name || 'Guest User',
                avatar: user.picture || null,
                content: content,
                rating: rating,
                createdAt: new Date().toISOString(),
                likes: [],
                likeCount: 0
            };
            
            try {
                // Try to save to API first
                if (token) {
                    const apiUrl = typeof API_CONFIG !== 'undefined' 
                        ? API_CONFIG.BASE_URL 
                        : 'https://luganda-translated-movies-production.up.railway.app';
                    
                    const response = await fetch(`${apiUrl}/api/comments`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': `Bearer ${token}`
                        },
                        body: JSON.stringify({
                            movieId: movieId,
                            content: content,
                            rating: rating
                        })
                    });
                    
                    if (response.ok) {
                        const data = await response.json();
                        newComment.id = data.data?.comment?._id || newComment.id;
                    }
                }
            } catch (error) {
                console.log('API not available, saving locally');
            }
            
            // Save to localStorage as backup
            const localComments = JSON.parse(localStorage.getItem(`comments_${movieId}`) || '[]');
            localComments.unshift(newComment);
            localStorage.setItem(`comments_${movieId}`, JSON.stringify(localComments));
            
            // Add to display
            allComments.unshift(newComment);
            
            // Hide no comments message
            const noCommentsEl = document.getElementById('noComments');
            if (noCommentsEl) noCommentsEl.style.display = 'none';
            
            // Render the new comment
            const listEl = document.getElementById('commentsList');
            const commentEl = createCommentElement(newComment);
            const firstComment = listEl.querySelector('.comment-item');
            if (firstComment) {
                listEl.insertBefore(commentEl, firstComment);
            } else {
                listEl.appendChild(commentEl);
            }
            
            // Update count
            const countEl = document.getElementById('commentCount');
            if (countEl) {
                countEl.textContent = `${allComments.length} comments`;
            }
            
            // Clear form
            input.value = '';
            input.rows = 1;
            input.style.height = 'auto';
            document.getElementById('commentActions').style.display = 'none';
            document.querySelectorAll('.star-rating-input input').forEach(r => r.checked = false);
            
            // Show success feedback
            showNotification('Comment posted successfully!', 'success');
        }
        
        // Toggle comment like
        function toggleCommentLike(commentId) {
            const isLiked = localStorage.getItem(`comment_liked_${commentId}`) === 'true';
            localStorage.setItem(`comment_liked_${commentId}`, !isLiked);
            
            // Update UI
            const btn = document.querySelector(`.comment-item[data-id="${commentId}"] .comment-action-btn`);
            if (btn) {
                btn.classList.toggle('liked');
                const countSpan = btn.querySelector('span');
                if (countSpan) {
                    const currentCount = parseInt(countSpan.textContent) || 0;
                    countSpan.textContent = isLiked ? Math.max(0, currentCount - 1) : currentCount + 1;
                }
            }
        }
        
        // Reply to comment
        function replyToComment(commentId, author) {
            const input = document.getElementById('commentInput');
            if (input) {
                input.value = `@${author} `;
                input.focus();
                document.getElementById('commentActions').style.display = 'flex';
            }
        }
        
        // Helper: Format time ago
        function formatTimeAgo(date) {
            const seconds = Math.floor((new Date() - date) / 1000);
            const intervals = {
                year: 31536000,
                month: 2592000,
                week: 604800,
                day: 86400,
                hour: 3600,
                minute: 60
            };
            
            for (const [unit, secondsInUnit] of Object.entries(intervals)) {
                const interval = Math.floor(seconds / secondsInUnit);
                if (interval >= 1) {
                    return `${interval} ${unit}${interval > 1 ? 's' : ''} ago`;
                }
            }
            return 'Just now';
        }
        
        // Helper: Escape HTML
        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
        
        // Helper: Show notification
        function showNotification(message, type = 'info') {
            const notification = document.createElement('div');
            notification.style.cssText = `
                position: fixed;
                top: 80px;
                right: 20px;
                background: ${type === 'success' ? 'var(--primary-color)' : type === 'error' ? '#FF6B6B' : 'var(--background-light)'};
                color: ${type === 'success' ? '#000' : '#fff'};
                padding: 15px 20px;
                border-radius: 10px;
                box-shadow: 0 5px 20px rgba(0,0,0,0.3);
                z-index: 10000;
                animation: slideIn 0.3s ease;
                max-width: 300px;
            `;
            notification.textContent = message;
            document.body.appendChild(notification);
            
            setTimeout(() => {
                notification.style.animation = 'slideOut 0.3s ease';
                setTimeout(() => notification.remove(), 300);
            }, 3000);
        }
        
        // ===================================
        // Smart Player: Resume + Progress Sync
        // ===================================

        function formatClock(seconds) {
            const s = Math.max(0, Math.floor(Number(seconds) || 0));
            const h = Math.floor(s / 3600);
            const m = Math.floor((s % 3600) / 60);
            const sec = s % 60;
            if (h > 0) return `${h}:${String(m).padStart(2, '0')}:${String(sec).padStart(2, '0')}`;
            return `${m}:${String(sec).padStart(2, '0')}`;
        }

        function getMovieMetaForProgress() {
            return {
                id: movieId,
                title: document.getElementById('movieTitle')?.textContent || 'Unknown',
                poster: document.getElementById('moviePoster')?.src || '',
                vj: document.getElementById('vjName')?.textContent || undefined
            };
        }

        function saveWatchProgress(currentTime, duration) {
            if (!movieId || !duration || isNonMoviePlayback || isEmbedMode) return;

            const safeTime = Math.max(0, Math.min(Number(currentTime) || 0, Number(duration) || 0));
            const safeDuration = Math.max(0, Number(duration) || 0);

            // Legacy/local key (kept for backwards compatibility)
            const percentage = safeDuration > 0 ? (safeTime / safeDuration) * 100 : 0;
            const watchProgress = JSON.parse(localStorage.getItem('watchProgress') || '{}');
            watchProgress[movieId] = {
                currentTime: safeTime,
                duration: safeDuration,
                percentage,
                lastWatched: new Date().toISOString(),
                title: document.getElementById('movieTitle')?.textContent || 'Unknown',
                poster: document.getElementById('moviePoster')?.src || ''
            };
            localStorage.setItem('watchProgress', JSON.stringify(watchProgress));

            // Preferred: WatchlistManager history + server sync
            if (typeof WatchlistManager !== 'undefined' && WatchlistManager?.addToHistory) {
                WatchlistManager.addToHistory(getMovieMetaForProgress(), safeTime, safeDuration);
            }
        }

        function getResumeCandidate() {
            if (!movieId) return null;

            const candidates = [];

            // Prefer WatchlistManager history
            if (typeof WatchlistManager !== 'undefined' && WatchlistManager?.getHistory) {
                const history = WatchlistManager.getHistory();
                const item = (history || []).find(h => String(h.id) === String(movieId));
                if (item && typeof item.progress === 'number' && typeof item.duration === 'number') {
                    candidates.push({
                        source: 'history',
                        time: item.progress,
                        duration: item.duration,
                        last: item.watchedAt ? Date.parse(item.watchedAt) : 0
                    });
                }
            }

            // Fallback to legacy watchProgress
            try {
                const wp = JSON.parse(localStorage.getItem('watchProgress') || '{}');
                const item = wp && wp[movieId];
                if (item && typeof item.currentTime === 'number' && typeof item.duration === 'number') {
                    candidates.push({
                        source: 'legacy',
                        time: item.currentTime,
                        duration: item.duration,
                        last: item.lastWatched ? Date.parse(item.lastWatched) : 0
                    });
                }
            } catch {
                // ignore
            }

            if (candidates.length === 0) return null;
            candidates.sort((a, b) => (b.last || 0) - (a.last || 0));
            return candidates[0];
        }

        function showResumePrompt(resumeTime) {
            const wrapper = document.querySelector('.video-wrapper');
            if (!wrapper) return;

            // Prevent duplicates
            if (document.getElementById('resumePrompt')) return;

            const el = document.createElement('div');
            el.id = 'resumePrompt';
            el.style.cssText = `
                position:absolute;
                left:16px;
                right:16px;
                bottom:16px;
                background: rgba(0,0,0,0.75);
                border: 1px solid rgba(255,255,255,0.12);
                border-radius: 14px;
                padding: 14px 14px;
                display:flex;
                align-items:center;
                justify-content:space-between;
                gap:12px;
                z-index: 50;
                backdrop-filter: blur(8px);
            `;

            el.innerHTML = `
                <div style="display:flex;flex-direction:column;gap:2px;min-width:0;">
                    <div style="font-weight:700;color:#fff;">Resume watching?</div>
                    <div style="color:rgba(255,255,255,0.75);font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">Continue from ${formatClock(resumeTime)}</div>
                </div>
                <div style="display:flex;gap:10px;flex-shrink:0;">
                    <button type="button" id="resumeBtn" class="btn btn-primary" style="padding:10px 14px;">Resume</button>
                    <button type="button" id="restartBtn" class="btn btn-secondary" style="padding:10px 14px;">Start over</button>
                </div>
            `;

            wrapper.style.position = wrapper.style.position || 'relative';
            wrapper.appendChild(el);

            const cleanup = () => {
                const node = document.getElementById('resumePrompt');
                if (node) node.remove();
            };

            const resumeBtn = document.getElementById('resumeBtn');
            const restartBtn = document.getElementById('restartBtn');

            if (resumeBtn) {
                resumeBtn.addEventListener('click', async () => {
                    try {
                        video.currentTime = resumeTime;
                        await video.play().catch(() => {});
                    } finally {
                        cleanup();
                    }
                });
            }

            if (restartBtn) {
                restartBtn.addEventListener('click', () => {
                    try {
                        video.currentTime = 0;
                    } finally {
                        cleanup();
                    }
                });
            }

            // Auto-dismiss after 12 seconds
            setTimeout(cleanup, 12000);
        }

        let lastProgressSaveAt = 0;
        let resumeChecked = false;

        if (video) {
            // Offer resume once per page load, after metadata available
            video.addEventListener('loadedmetadata', () => {
                if (resumeChecked) return;
                resumeChecked = true;
                if (isNonMoviePlayback || isEmbedMode) return;

                // Allow explicit disabling
                if (urlParams.get('resume') === '0') return;

                // Allow user preference to disable resume prompt
                if (localStorage.getItem('unruly_resume_enabled') === 'false') return;

                const candidate = getResumeCandidate();
                if (!candidate || !candidate.duration) return;

                const duration = Number(video.duration) || Number(candidate.duration) || 0;
                const time = Math.max(0, Math.min(Number(candidate.time) || 0, duration));
                const percent = duration > 0 ? (time / duration) * 100 : 0;

                // Only prompt for meaningful progress
                if (time < 30) return;
                if (duration > 0 && (duration - time) < 30) return;
                if (percent < 5 || percent > 90) return;

                showResumePrompt(time);
            }, { once: true });

            // Track video progress (throttled)
            video.addEventListener('timeupdate', () => {
                if (!video.duration || !video.currentTime) return;
                const now = Date.now();
                if (now - lastProgressSaveAt < 10_000) return;
                lastProgressSaveAt = now;
                saveWatchProgress(video.currentTime, video.duration);
            });

            // Save on pause/seek
            video.addEventListener('pause', () => {
                if (video.duration && video.currentTime) {
                    saveWatchProgress(video.currentTime, video.duration);
                }
            });

            // Mark completion + suggest next
            video.addEventListener('ended', () => {
                if (video.duration) {
                    saveWatchProgress(video.duration, video.duration);
                }

                // Simple autoplay-next (if enabled)
                const autoNext = localStorage.getItem('unruly_autonext') === 'true';
                if (!autoNext) return;

                const firstRelated = document.querySelector('#relatedGrid a.movie-card');
                const href = firstRelated?.getAttribute('href');
                if (href) {
                    window.location.href = href;
                }
            });
        }

        // Service Worker Registration
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js').catch(err => console.log('SW registration failed'));
            });
        }
    </script>
    
    <!-- System Notification -->
    <script src="js/system-notification.js"></script>
    
    <!-- Player Enhancement Scripts -->
    <script src="js/mobile-gestures.js"></script>
    <script src="js/quality-selector.js"></script>
    <script src="js/report-system.js"></script>
    <script src="js/live-chat-widget.js"></script>
    
    <!-- TMDB API and Trailer Player -->
    <script src="js/tmdb-api.js"></script>
    <script src="js/trailer-player.js"></script>
    <script>
        // Initialize TMDB API and Trailer Player
        window.tmdbApi = new TMDBApiClient();
        window.trailerPlayer = new TrailerPlayer();
    </script>
    
    <!-- Login Gate - Requires login to watch full movie -->
    <script src="js/login-gate.js"></script>
</body>
</html>